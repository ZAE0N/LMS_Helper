# OpenAI 호환 API
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# 그림 속 글자 읽기용 (비우면 LLM_MODEL, 그림을 읽을 수 있는 모델이어야 함)
LLM_VISION_MODEL=

# 확장 프로그램 ID (chrome://extensions 에서 확인)
ALLOWED_ORIGINS=chrome-extension://[확장프로그램_ID]

# PDF 보기(베타): 별도 가상환경에 설치한 pdf2zh_next 실행 파일 경로. 비우면 기능 꺼짐
# 예) C:\dev\pdftest\Scripts\pdf2zh_next.exe
PDF2ZH_BIN=
# PDF 보기용 모델 (비우면 LLM_MODEL)
PDF2ZH_MODEL=
