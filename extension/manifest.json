{
  "manifest_version": 3,
  "name": "LMS Helper",
  "version": "0.1.0",
  "description": "외국인 유학생을 위한 인하공전 LMS 도우미",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://lms-app.inhatc.ac.kr/*", "http://localhost:8000/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "LMS Helper" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    {
      "matches": ["https://lms-app.inhatc.ac.kr/*"],
      "js": ["config.js", "mock.js", "content.js", "widgets.js"],
      "css": ["theme.css", "widgets.css"],
      "run_at": "document_start"
    }
  ]
}
